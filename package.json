{
  "name": "@konkonrong/mf-check",
  "version": "0.3.1",
  "description": "Preflight checks for Salesforce Multi-Framework projects.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mf-check": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "salesforce",
    "multi-framework",
    "cli",
    "preflight",
    "graphql"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konkonrong-lgtm/mf-check.git"
  },
  "bugs": {
    "url": "https://github.com/konkonrong-lgtm/mf-check/issues"
  },
  "homepage": "https://github.com/konkonrong-lgtm/mf-check#readme"
}
